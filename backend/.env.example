APP_NAME=Roadtrip Planner
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/roadtrip_planner
# REQUIRED: your own Google Maps Platform key (Routes API + Places API (New) enabled).
# You can use the same key as the frontend's VITE_GOOGLE_MAPS_API_KEY. See "API keys" in the README. Never commit a real key.
MAPS_API_KEY=
# Optional: DEMO_KEY works but is heavily rate limited (EV charger search only).
# Get a free key at https://developer.nlr.gov/signup/
NREL_API_KEY=DEMO_KEY
PLACES_REQUESTS_PER_MINUTE=100
